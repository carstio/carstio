{% extends 'layout.html.twig' %}
{% import '_macros/icon.html.twig' as icon %}

{% block title %}{{ 'client.index.title'|trans }} | {{ 'app.name'|trans }}{% endblock %}

{% block content %}
    {% include '_partials/page_head.html.twig' with {
        head_icon: 'clients',
        title: 'client.index.heading'|trans,
        primary: { label: 'client.action.new'|trans, href: path('app_client_new'), icon: 'plus' }
    } only %}

    {% include '_partials/toolbar.html.twig' with {
        search_value: search,
        search_placeholder: ('action.search'|trans) ~ ' ' ~ ('nav.clients'|trans|lower) ~ '…'
    } only %}

    <div class="card">
        {% if clients is empty %}
            <div class="card-body">
                {% include '_partials/empty_state.html.twig' with {
                    icon_name: 'clients',
                    title: 'client.index.empty_title'|trans,
                    text: 'client.index.empty'|trans,
                    primary: { label: 'client.action.new'|trans, href: path('app_client_new'), icon: 'plus' }
                } only %}
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="data-table table mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'client.field.name'|trans }}</th>
                            <th>{{ 'client.field.phone'|trans }}</th>
                            <th>{{ 'client.field.email'|trans }}</th>
                            <th class="text-center">{{ 'client.field.cars'|trans }}</th>
                            <th class="col-actions">{{ 'label.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <td class="col-primary">
                                    <a href="{{ path('app_client_show', {id: client.id}) }}">{{ client.name }}</a>
                                </td>
                                <td>{{ client.phone }}</td>
                                <td>{{ client.email ?? '-' }}</td>
                                <td class="text-center tabular-nums">{{ client.cars|length }}</td>
                                <td class="col-actions">
                                    <a href="{{ path('app_client_edit', {id: client.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="{{ 'action.edit'|trans }}" title="{{ 'action.edit'|trans }}">
                                        {{ icon.render('pencil') }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
