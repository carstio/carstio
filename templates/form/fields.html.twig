{% use "bootstrap_5_layout.html.twig" %}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({ class: (row_attr.class|default('') ~ ' mb-3')|trim }) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' form-label fw-medium')|trim }) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        {%- set help_attr = help_attr|merge({ class: (help_attr.class|default('') ~ ' form-text text-muted small')|trim }) -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_help -%}
