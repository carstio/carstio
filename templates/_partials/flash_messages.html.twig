{% import '_macros/icon.html.twig' as icon %}
{% set icon_map = {
    'success': 'check',
    'info':    'info',
    'warning': 'warning',
    'danger':  'warning',
    'error':   'warning'
} %}

{% for type, messages in app.flashes %}
    {% set flash_type = type == 'error' ? 'danger' : type %}
    {% for message in messages %}
        <div class="alert alert-{{ flash_type }} alert-dismissible fade show" role="alert">
            {{ icon.render(icon_map[type] ?? 'info', {size: 18}) }}
            <div class="flex-grow-1">{{ message|trans }}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'action.close'|trans }}"></button>
        </div>
    {% endfor %}
{% endfor %}
