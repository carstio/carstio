{% extends 'base.html.twig' %}
{% import '_macros/icon.html.twig' as icon %}

{% block body %}
    <div class="sidebar-backdrop" id="sidebarBackdrop" data-controller="sidebar" data-action="click->sidebar#close"></div>

    {% include '_partials/sidebar.html.twig' %}

    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="{{ 'nav.toggle_menu'|trans }}" data-controller="sidebar" data-action="click->sidebar#toggle">
                    {{ icon.render('menu', {size: 18}) }}
                </button>
                <span class="topbar-crumb">{% block page_title %}{% endblock %}</span>
            </div>

            {% include '_partials/global_search.html.twig' %}

            <div class="d-flex align-items-center gap-3">
                <span class="topbar-user d-none d-md-inline">{{ app.user.fullName }}</span>
                {% include '_partials/language_switcher.html.twig' with {variant: 'topbar'} %}
                {# Icon only on a phone, where the bar has no room for the word. #}
                <button type="submit" form="logout-form" class="btn btn-outline-secondary btn-sm" title="{{ 'nav.logout'|trans }}" aria-label="{{ 'nav.logout'|trans }}">
                    {{ icon.render('logout', {size: 14}) }}
                    <span class="d-none d-sm-inline">{{ 'nav.logout'|trans }}</span>
                </button>
            </div>
        </header>

        <main class="app-content">
            {% include '_partials/flash_messages.html.twig' %}
            {% block content %}{% endblock %}
        </main>
    </div>

    {# Detached logout form (POST + CSRF token) targeted by the topbar button
       via the HTML5 `form` attribute. Kept after the page content so it never
       nests in a business form and so the business form stays first in DOM
       order (tests rely on that, see base.html.twig). #}
    <form id="logout-form" method="post" action="{{ path('app_logout') }}" class="d-none">
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
    </form>
{% endblock %}
