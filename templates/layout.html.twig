{% extends 'base.html.twig' %}
{% import '_macros/icon.html.twig' as icon %}

{% block body %}
    <div class="sidebar-backdrop" id="sidebarBackdrop" data-controller="sidebar" data-action="click->sidebar#close"></div>

    {% include '_partials/sidebar.html.twig' %}

    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="{{ 'nav.toggle_menu'|trans }}" data-controller="sidebar" data-action="click->sidebar#toggle">
                    {{ icon.render('menu', {size: 18}) }}
                </button>
                <span class="topbar-crumb">{% block page_title %}{% endblock %}</span>
            </div>

            {% include '_partials/global_search.html.twig' %}

            <div class="d-flex align-items-center gap-3">
                <span class="topbar-user d-none d-md-inline">{{ app.user.fullName }}</span>
                {% include '_partials/language_switcher.html.twig' with {variant: 'topbar'} %}
                <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">
                    {{ icon.render('logout', {size: 14}) }}
                    <span>{{ 'nav.logout'|trans }}</span>
                </a>
            </div>
        </header>

        <main class="app-content">
            {% include '_partials/flash_messages.html.twig' %}
            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}
