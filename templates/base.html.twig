<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body data-i18n-button-now="{{ 'js.button.now'|trans }}"
      data-i18n-button-today="{{ 'js.button.today'|trans }}"
      data-i18n-action-remove="{{ 'js.action.remove'|trans }}">
    {% block body %}{% endblock %}

    {# Detached form used by the language switcher dropdown via the HTML5
       `form` attribute on its buttons. Kept here so it does not nest in
       any business form and stays last in DOM order. #}
    <form id="language-switcher-form" method="post" class="d-none">
        <input type="hidden" name="_token" value="{{ csrf_token('locale-switch') }}">
    </form>
</body>
</html>
