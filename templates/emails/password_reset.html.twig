<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ subject|e('html') }}</title>
</head>
<body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#222;background:#f6f7f9;">
<div style="max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e3e6eb;border-radius:8px;padding:24px;">
    <h1 style="margin:0 0 16px;font-size:20px;color:#111;">{{ 'email.password_reset.heading'|trans }}</h1>

    <p style="margin:0 0 12px;">{{ 'email.greeting'|trans({'%name%': name}) }}</p>
    <p style="margin:0 0 16px;">{{ 'email.password_reset.intro'|trans({'%company%': company}) }}</p>

    <p style="margin:0 0 16px;">
        <a href="{{ reset_url }}" style="display:inline-block;padding:10px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">{{ 'email.password_reset.action'|trans }}</a>
    </p>

    <p style="margin:0 0 12px;">{{ 'email.password_reset.expiry'|trans({'%minutes%': minutes}) }}</p>
    <p style="margin:0 0 16px;">{{ 'email.password_reset.ignore'|trans }}</p>

    <p style="margin:0 0 4px;color:#555;font-size:13px;">{{ 'email.password_reset.link_fallback'|trans }}</p>
    <p style="margin:0 0 16px;font-size:13px;word-break:break-all;"><a href="{{ reset_url }}">{{ reset_url }}</a></p>

    <hr style="border:none;border-top:1px solid #e3e6eb;margin:24px 0 12px;">
    <p style="margin:0;color:#888;font-size:12px;">{{ 'email.footer.generated_by'|trans }}</p>
</div>
</body>
</html>
