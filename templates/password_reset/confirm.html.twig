{% extends 'password_reset/_card.html.twig' %}

{% block card_title %}{{ 'password_reset.confirm.heading'|trans }}{% endblock %}
{% block card_subtitle %}{{ email }}{% endblock %}

{% block card_body %}
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        <button type="submit" class="btn btn-primary btn-lg w-100">{{ 'password_reset.confirm.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
