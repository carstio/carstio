{% extends 'password_reset/_card.html.twig' %}

{% block card_title %}{{ 'password_reset.request.heading'|trans }}{% endblock %}
{% block card_subtitle %}{{ 'password_reset.request.subtitle'|trans }}{% endblock %}

{% block card_body %}
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.email) }}
        <button type="submit" class="btn btn-primary btn-lg w-100">{{ 'password_reset.request.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
