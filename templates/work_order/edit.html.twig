{% extends 'layout.html.twig' %}
{% import '_macros/icon.html.twig' as icon %}

{% block title %}{{ 'work_order.edit.title'|trans }} | {{ 'app.name'|trans }}{% endblock %}

{% block content %}
    {% include '_partials/page_head.html.twig' with {
        head_icon: 'work-order',
        title: 'work_order.edit.title'|trans,
        subtitle: work_order.number
    } only %}

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div data-controller="collection"
         data-collection-prototype-value="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}"
         data-collection-index-value="{{ form.items|length }}">

        <ul class="nav nav-tabs mb-0" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-details" data-bs-toggle="tab" data-bs-target="#pane-details" type="button" role="tab">
                    {{ 'work_order.edit.tab.details'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-labor" data-bs-toggle="tab" data-bs-target="#pane-labor" type="button" role="tab">
                    {{ 'work_order.edit.tab.labor'|trans }}
                    {% set labor_count = 0 %}
                    {% for item in form.items %}
                        {% if item.vars.data and item.vars.data.type and item.vars.data.type.value == 'labor' %}
                            {% set labor_count = labor_count + 1 %}
                        {% endif %}
                    {% endfor %}
                    <span class="status-badge status-badge--open ms-2">{{ labor_count }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-parts" data-bs-toggle="tab" data-bs-target="#pane-parts" type="button" role="tab">
                    {{ 'work_order.edit.tab.parts'|trans }}
                    {% set parts_count = 0 %}
                    {% for item in form.items %}
                        {% if item.vars.data and item.vars.data.type and item.vars.data.type.value != 'labor' %}
                            {% set parts_count = parts_count + 1 %}
                        {% endif %}
                    {% endfor %}
                    <span class="status-badge status-badge--success ms-2">{{ parts_count }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-payments" data-bs-toggle="tab" data-bs-target="#pane-payments" type="button" role="tab">
                    {{ 'work_order.edit.tab.payments'|trans }}
                    <span class="status-badge status-badge--neutral ms-2">{{ work_order.payments|length }}</span>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="pane-details" role="tabpanel">
                <div class="section-card section-card--tabbed">
                    <div class="form-section">
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.client) }}</div>
                            <div class="col-md-6">{{ form_row(form.car) }}</div>
                            <div class="col-md-6">{{ form_row(form.status) }}</div>
                            <div class="col-md-6">{{ form_row(form.scheduledAt) }}</div>
                            <div class="col-md-6">{{ form_row(form.source) }}</div>
                            <div class="col-md-6">
                                {{ form_label(form.odometerReading) }}
                                <div class="input-group">
                                    {{ form_widget(form.odometerReading) }}
                                    <span class="input-group-text">{{ current_mileage_unit.value }}</span>
                                </div>
                                {{ form_help(form.odometerReading) }}
                                {{ form_errors(form.odometerReading) }}
                            </div>
                        </div>
                        <hr class="my-4">
                        {{ form_row(form.complaint) }}
                        {{ form_row(form.diagnosis) }}
                        {{ form_row(form.notes) }}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="pane-labor" role="tabpanel">
                <div class="section-card section-card--tabbed">
                    <div class="form-section">
                        <div data-collection-target="laborList">
                            {% for item in form.items %}
                                {% if item.vars.data and item.vars.data.type and item.vars.data.type.value == 'labor' %}
                                    <div class="collection-item">
                                        {{ _self.render_item_row(item, false) }}
                                        <button type="button" class="collection-item-remove" data-action="collection#remove" aria-label="{{ 'action.delete'|trans }}">{{ icon.render('x', {size: 14}) }}</button>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <button type="button" class="btn btn-outline-primary mt-2" data-action="collection#addLabor">
                            {{ icon.render('plus') }}<span>{{ 'work_order.edit.add_labor'|trans }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="pane-parts" role="tabpanel">
                <div class="section-card section-card--tabbed">
                    <div class="form-section">
                        <div data-collection-target="partsList">
                            {% for item in form.items %}
                                {% if item.vars.data and item.vars.data.type and item.vars.data.type.value != 'labor' %}
                                    <div class="collection-item">
                                        {{ _self.render_item_row(item, true) }}
                                        <button type="button" class="collection-item-remove" data-action="collection#remove" aria-label="{{ 'action.delete'|trans }}">{{ icon.render('x', {size: 14}) }}</button>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <button type="button" class="btn btn-outline-primary mt-2" data-action="collection#addPart">
                            {{ icon.render('plus') }}<span>{{ 'work_order.edit.add_part'|trans }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="pane-payments" role="tabpanel">
                {% include 'work_order/_payments_tab.html.twig' with {
                    work_order: work_order,
                    payment_summary: payment_summary
                } only %}
            </div>
        </div>
    </div>

    <div class="d-none">{{ form_rest(form) }}</div>

    <div class="form-footer form-footer-sticky">
        <a href="{{ path('app_work_order_show', {id: work_order.id}) }}" class="btn btn-outline-secondary">{{ 'action.cancel'|trans }}</a>
        <button type="submit" class="btn btn-primary">{{ icon.render('check') }}<span>{{ 'action.save'|trans }}</span></button>
    </div>

    {{ form_end(form, {render_rest: false}) }}
{% endblock %}

{% macro render_item_row(item, show_part) %}
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md">
            {{ form_row(item.name) }}
        </div>
        <div class="col-6 col-md-2">
            {{ form_row(item.quantity) }}
        </div>
        <div class="col-6 col-md-2">
            {{ form_row(item.unitPrice) }}
        </div>
        <div class="col-6 col-md-2">
            {{ form_row(item.discountAmount) }}
        </div>
        <div class="col-6 col-md-2">
            {{ form_row(item.taxRate) }}
        </div>
    </div>
    {% if show_part and item.part is defined %}
        <div class="row g-2 mt-1">
            <div class="col-12 col-md-6">
                {{ form_row(item.part) }}
            </div>
            <div class="col-6 col-md-3">
                {{ form_row(item.costPrice) }}
            </div>
        </div>
    {% endif %}
    {{ form_widget(item.type) }}
    {{ form_widget(item.sortOrder) }}
{% endmacro %}
