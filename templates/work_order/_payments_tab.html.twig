{% import '_macros/icon.html.twig' as icon %}

<div class="section-card section-card--tabbed">
    <div class="section-card-body">
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
                <div class="totals-row">
                    <span>{{ 'work_order.field.total'|trans }}</span>
                    <span class="totals-value">{{ payment_summary.totalAmount|money(work_order.currencyCode) }}</span>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="totals-row">
                    <span>{{ 'work_order.payments.paid_amount'|trans }}</span>
                    <span class="totals-value">{{ payment_summary.paidAmount|money(work_order.currencyCode) }}</span>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="totals-row totals-total">
                    <span>{{ 'work_order.payments.remaining'|trans }}</span>
                    <span class="totals-value">{{ payment_summary.remainingAmount|money(work_order.currencyCode) }}</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-2">
            <div>
                <span class="text-muted me-2">{{ 'work_order.payments.status'|trans }}</span>
                {% include '_partials/payment_status_badge.html.twig' with {status: payment_summary.status} %}
            </div>
            <a href="{{ path('app_work_order_payment_new', {workOrder: work_order.id}) }}" class="btn btn-outline-primary">
                {{ icon.render('plus') }}<span>{{ 'work_order.payments.add'|trans }}</span>
            </a>
        </div>
    </div>

    {% if work_order.payments is empty %}
        <div class="section-card-body">
            <p class="text-muted mb-0">{{ 'work_order.payments.empty'|trans }}</p>
        </div>
    {% else %}
        <div class="section-card-body section-card-body--flush">
            <div class="table-responsive">
                <table class="data-table table mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'payment.field.paid_at'|trans }}</th>
                            <th class="col-numeric">{{ 'payment.field.amount'|trans }}</th>
                            <th>{{ 'payment.field.method'|trans }}</th>
                            <th>{{ 'payment.field.status'|trans }}</th>
                            <th>{{ 'payment.field.reference'|trans }}</th>
                            <th class="col-actions">{{ 'label.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in work_order.payments %}
                            <tr>
                                <td class="col-mono">{{ payment.paidAt|app_date }}</td>
                                <td class="col-numeric fw-semibold">{{ payment.amount|money(work_order.currencyCode) }}</td>
                                <td>{{ ('payment.method.' ~ payment.method.value)|trans }}</td>
                                <td>{% include '_partials/payment_status_badge.html.twig' with {status: payment.status} %}</td>
                                <td class="col-mono">{{ payment.reference ?? '-' }}</td>
                                <td class="col-actions">
                                    <a href="{{ path('app_payment_show', {id: payment.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="{{ 'action.view'|trans }}" title="{{ 'work_order.payments.view'|trans }}">
                                        {{ icon.render('eye') }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
