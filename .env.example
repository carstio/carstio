# Copy this file to `.env.local` and tweak values for your local setup.
# Never commit real secrets. See https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Required for every non-dev environment (prod refuses to start without it).
# Generate one with: php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
APP_SECRET=change-me-to-a-long-random-string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Default: app running inside Docker, talking to the `database` service.
# When running the app on the host (outside Docker) and only the database
# in Docker, point this at 127.0.0.1 and the host port published by
# compose.override.yaml (default 3307).
DATABASE_URL="mysql://carstio:carstio@database:3306/carstio?serverVersion=mariadb-11.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> mariadb (compose.yaml) ###
# These are read by docker compose to seed the MariaDB image. They are
# obvious dev-only credentials — change them for any real deployment by
# providing a .env.local on the machine that runs `docker compose up`.
MARIADB_VERSION=11.4
MARIADB_DATABASE=carstio
MARIADB_USER=carstio
MARIADB_PASSWORD=carstio
MARIADB_ROOT_PASSWORD=rootcarstio
###< mariadb (compose.yaml) ###

###> symfony/mailer ###
# Default points at the Mailpit container (compose.override.yaml).
# Use null://null to silently swallow outgoing mail in CLI / tests.
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> web (compose.override.yaml) ###
# Host port the Caddy container listens on. Override if 8080 is taken.
WEB_PORT=8080
###< web (compose.override.yaml) ###
